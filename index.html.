<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Una Flor Amarilla Para Ti 🌻</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background-color: #0d0d1a;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    canvas {
      display: block;
    }
    #message {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      color: #fff7d1;
      font-size: 1.5rem;
      font-weight: 600;
      text-align: center;
      text-shadow: 0 0 10px rgba(255, 215, 0, 0.8), 0 0 20px rgba(255, 165, 0, 0.5);
      pointer-events: none;
      width: 90%;
      max-width: 600px;
    }
  </style>
</head>
<body>

  <div id="message">✨ Una flor amarilla especial para ti ✨</div>

  <!-- Carga de Three.js y OrbitControls para poder girar la flor con el dedo o mouse -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

  <script>
    // 1. Escena, Cámara y Renderizador
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0a14);

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 3, 12);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    document.body.appendChild(renderer.domElement);

    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.maxDistance = 20;
    controls.minDistance = 3;

    // 2. Iluminación Ambiente y Direccional Cálida
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
    scene.add(ambientLight);

    const mainLight = new THREE.DirectionalLight(0xfffaed, 1.2);
    mainLight.position.set(5, 10, 7);
    mainLight.castShadow = true;
    scene.add(mainLight);

    const backLight = new THREE.DirectionalLight(0xffa500, 0.5);
    backLight.position.set(-5, -5, -5);
    scene.add(backLight);

    // Grupo principal de la flor
    const flowerGroup = new THREE.Group();

    // 3. Creación del Centro de la Flor
    const centerGeo = new THREE.SphereGeometry(1.2, 32, 32);
    centerGeo.scale(1, 0.6, 1);
    const centerMat = new THREE.MeshStandardMaterial({
      color: 0x5c3a21,
      roughness: 0.8,
      bumpScale: 0.05
    });
    const centerMesh = new THREE.Mesh(centerGeo, centerMat);
    centerMesh.position.y = 0.2;
    flowerGroup.add(centerMesh);

    // 4. Función para Generar Pétalos con Curvatura Realista
    function createPetal() {
      const shape = new THREE.Shape();
      shape.moveTo(0, 0);
      shape.bezierCurveTo(0.4, 0.8, 0.8, 2.2, 0.3, 3.8);
      shape.bezierCurveTo(0, 4.3, -0.3, 4.3, -0.3, 3.8);
      shape.bezierCurveTo(-0.8, 2.2, -0.4, 0.8, 0, 0);

      const extrudeSettings = {
        steps: 2,
        depth: 0.08,
        bevelEnabled: true,
        bevelThickness: 0.05,
        bevelSize: 0.05,
        bevelSegments: 3
      };

      const geo = new THREE.ExtrudeGeometry(shape, extrudeSettings);
      geo.center();

      const mat = new THREE.MeshStandardMaterial({
        color: 0xffd700, // Amarillo dorado brillante
        roughness: 0.3,
        metalness: 0.1,
        side: THREE.DoubleSide
      });

      return new THREE.Mesh(geo, mat);
    }

    // 5. Distribución de Capas de Pétalos (Capa Interior y Exterior)
    const petalCountInner = 14;
    for (let i = 0; i < petalCountInner; i++) {
      const petal = createPetal();
      const angle = (i / petalCountInner) * Math.PI * 2;
      
      petal.position.x = Math.cos(angle) * 0.9;
      petal.position.z = Math.sin(angle) * 0.9;
      petal.position.y = 0.1;

      petal.rotation.y = -angle + Math.PI / 2;
      petal.rotation.x = Math.PI / 2.3; // Inclinación
      petal.scale.set(0.7, 0.8, 0.7);

      flowerGroup.add(petal);
    }

    const petalCountOuter = 18;
    for (let i = 0; i < petalCountOuter; i++) {
      const petal = createPetal();
      const angle = (i / petalCountOuter) * Math.PI * 2 + 0.2; // Desfase
      
      petal.position.x = Math.cos(angle) * 1.3;
      petal.position.z = Math.sin(angle) * 1.3;
      petal.position.y = -0.1;

      petal.rotation.y = -angle + Math.PI / 2;
      petal.rotation.x = Math.PI / 2.1;
      petal.scale.set(0.85, 0.95, 0.85);

      flowerGroup.add(petal);
    }

    // 6. Tallo Verdecito Curvo
    const stemCurve = new THREE.CatmullRomCurve3([
      new THREE.Vector3(0, 0, 0),
      new THREE.Vector3(0.1, -2, 0.2),
      new THREE.Vector3(-0.1, -4, 0.1),
      new THREE.Vector3(0, -6, 0)
    ]);

    const stemGeo = new THREE.TubeGeometry(stemCurve, 32, 0.15, 16, false);
    const stemMat = new THREE.MeshStandardMaterial({ color: 0x2e8b57, roughness: 0.5 });
    const stemMesh = new THREE.Mesh(stemGeo, stemMat);
    flowerGroup.add(stemMesh);

    // 7. Hoja Lateral
    function createLeaf() {
      const shape = new THREE.Shape();
      shape.moveTo(0, 0);
      shape.bezierCurveTo(0.8, 0.5, 1.2, 1.5, 0.8, 2.5);
      shape.bezierCurveTo(0.3, 3.0, 0, 3.2, -0.2, 2.8);
      shape.bezierCurveTo(-0.8, 1.8, -0.5, 0.8, 0, 0);

      const geo = new THREE.ShapeGeometry(shape);
      const mat = new THREE.MeshStandardMaterial({ color: 0x3cb371, side: THREE.DoubleSide, roughness: 0.4 });
      const leaf = new THREE.Mesh(geo, mat);
      return leaf;
    }

    const leaf1 = createLeaf();
    leaf1.position.set(0, -2.5, 0.1);
    leaf1.rotation.z = -Math.PI / 3;
    leaf1.rotation.x = 0.3;
    leaf1.scale.set(0.6, 0.6, 0.6);
    flowerGroup.add(leaf1);

    scene.add(flowerGroup);

    // Centrar suavemente la flor
    flowerGroup.position.y = 1;

    // 8. Bucle de Animación (Rotación suave y balanceo)
    let clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const time = clock.getElapsedTime();

      // Rotación continua lenta
      flowerGroup.rotation.y = time * 0.25;

      // Movimiento de vaivén tipo brisa
      flowerGroup.rotation.z = Math.sin(time * 1.2) * 0.05;

      controls.update();
      renderer.render(scene, camera);
    }

    animate();

    // Ajustar si la pantalla cambia de tamaño
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
